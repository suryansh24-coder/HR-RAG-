# --- Environment -----------------------------------------------------------
.env
.env.*
!.env.example

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# --- Node / frontend -------------------------------------------------------
node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
*.tsbuildinfo

# --- Application data ------------------------------------------------------
# Uploaded documents, the local Qdrant store and the SQLite database are runtime
# artefacts, not source. Users upload their own HR policies here, so the whole
# directory is ignored by default...
data/documents/*
!data/documents/fictional_*
data/qdrant/
data/*.db
data/*.db-shm
data/*.db-wal
!data/documents/.gitkeep

# --- Secrets ---------------------------------------------------------------
*.pem
*.key
secrets/
service-account*.json

# --- Editors / OS ----------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- Logs ------------------------------------------------------------------
*.log
logs/
