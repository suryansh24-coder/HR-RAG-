# Two different things live in this file — do not confuse them.
#
# 1. VITE_BACKEND_ORIGIN is read by `vite.config.ts` at *dev* time only: it is
#    where the dev server proxies `/api`. It is not compiled into the bundle.
# 2. VITE_API_ORIGIN is read by `src/api/client.ts` at *build* time and becomes
#    the absolute origin every API call is prefixed with. Leave it empty for the
#    normal setup (the Vite dev server and the production nginx config both proxy
#    `/api` on the same origin). Set it only when the app and the API are served
#    from genuinely different origins, and add the app's origin to the backend's
#    CORS_ORIGINS.

VITE_BACKEND_ORIGIN=http://localhost:8000
VITE_API_ORIGIN=
