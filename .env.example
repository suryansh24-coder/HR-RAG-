# ---------------------------------------------------------------------------
# HR Nexus - environment configuration
# Copy this file to `.env` in the project root and fill in the values you need.
# `.env` is git-ignored: never commit real keys.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME=HR Nexus
APP_VERSION=1.0.0
# development | production | test
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
API_PREFIX=/api

# --- URLs / CORS -----------------------------------------------------------
# Where the API is reachable (used in docs and by the frontend proxy).
API_URL=http://localhost:8000
# The frontend origin. Always allow-listed in CORS.
FRONTEND_URL=http://localhost:5173
# Extra origins, comma separated. Defaults to FRONTEND_URL when empty.
CORS_ORIGINS=
# Set to true only when running behind a trusted reverse proxy.
TRUST_PROXY_HEADERS=false

# --- Storage ---------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=20
# QDRANT_PATH is only used in local mode (data/qdrant).
QDRANT_PATH=./data/qdrant

# --- Qdrant ----------------------------------------------------------------
# "local" uses embedded persistence (no server required).
# Use https://<cluster>.cloud.qdrant.io:6333 for Qdrant Cloud.
QDRANT_URL=local
QDRANT_API_KEY=
QDRANT_COLLECTION=hr_documents
QDRANT_GRPC=false
QDRANT_TIMEOUT_SECONDS=20

# --- Embeddings ------------------------------------------------------------
# The same model embeds documents and questions. Changing it changes the
# vector dimension, which re-creates the collection on next start.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# cpu | cuda | mps
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16

# --- RAG retrieval ---------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
# Cosine similarity floor. Chunks scoring below this are discarded and the
# assistant refuses to answer instead of guessing. Raise it for stricter
# grounding, lower it (e.g. 0.15) if legitimate questions are being rejected.
SCORE_THRESHOLD=0.25
# Maximum chunks contributed by a single document, so one long file cannot
# crowd out every other source.
MAX_CHUNKS_PER_DOCUMENT=2
# Maximum chunks placed in the prompt context.
MAX_CONTEXT_CHUNKS=6
# Previous user turns used to resolve elliptical follow-up questions.
HISTORY_TURNS=2

# --- LLM provider ----------------------------------------------------------
# openai | claude | gemini | extractive
# "extractive" is a deterministic offline provider that quotes only retrieved
# text. It is refused when APP_ENV=production.
LLM_PROVIDER=extractive
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Only used by the openai provider (works with any OpenAI-compatible endpoint).
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=600
LLM_TIMEOUT_SECONDS=60

# Returned verbatim when retrieval finds nothing relevant.
NO_CONTEXT_RESPONSE=I couldn't find sufficient information about this topic in the HR knowledge base. Please contact HR or try rephrasing your question.

# --- Database --------------------------------------------------------------
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./data/hr_nexus.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+psycopg://hrnexus:change-me@localhost:5432/hrnexus
DB_ECHO=false

# --- Security --------------------------------------------------------------
# Bearer token required for upload / re-index / delete.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_AUTH_TOKEN=
# Force auth even when no token is set (auto-enabled in production, which makes
# write endpoints return 503 until a token is configured).
AUTH_REQUIRED=
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_UPLOADS_PER_MINUTE=10
ALLOWED_EXTENSIONS=.pdf,.txt,.md,.markdown
ALLOWED_CONTENT_TYPES=application/pdf,text/plain,text/markdown,text/x-markdown,application/octet-stream

# --- Observability ---------------------------------------------------------
# true adds retrieval scores, latencies and the embedded query to chat responses.
RAG_DEBUG=false
QUERY_LOG_ENABLED=true
QUERY_LOG_LIMIT=200

# --- Evaluation ------------------------------------------------------------
EVAL_TOP_K=2
